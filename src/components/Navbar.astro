---
import { siteConfig } from '../data/site';
import { biographyData } from '../data/biography';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const biographyDropdown = [
    { label: biographyData.profile.tabs.experience, anchor: 'experience' },
    { label: biographyData.profile.tabs.ventures, anchor: 'ventures' },
    { label: biographyData.profile.tabs.education, anchor: 'education' },
    { label: biographyData.profile.tabs.expertise, anchor: 'expertise' },
    { label: biographyData.profile.tabs.others, anchor: 'others' },
];
---

<nav class="navbar">
    <div class="navbar-container">
        <div class="nav-left">
            <a href={base} class="logo">{siteConfig.fullName}</a>
        </div>
        <button class="menu-toggle" aria-label={siteConfig.accessibility.menuToggleLabel}>
            <span class="hamburger"></span>
        </button>
        <div class="nav-right">
            <ul class="nav-links">
                {
                    siteConfig.navigation.map((item) => {
                        const fullHref = item.href.startsWith('#') ? item.href : `${base}${item.href.replace(/^\//, '')}`;
                        const isActive =
                            item.href === '/'
                                ? currentPath === base || currentPath === `${base}/`
                                : item.href === '/blog'
                                  ? currentPath.startsWith(`${base}blog`)
                                  : currentPath === fullHref || currentPath === `${fullHref}/`;

                        const isBiography = item.href === '/biography';

                        return (
                            <li class:list={[{ 'has-dropdown': isBiography }]}>
                                <a href={fullHref} class:list={[{ active: isActive }]}>
                                    {item.label}
                                    {isBiography && <span class="dropdown-arrow">▾</span>}
                                </a>
                                {isBiography && (
                                    <ul class="dropdown-menu">
                                        {biographyDropdown.map((section) => (
                                            <li>
                                                <a href={`${fullHref}#${section.anchor}`}>
                                                    {section.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
</nav>

<script>
    const menuToggle = document.querySelector('.menu-toggle');
    const navRight = document.querySelector('.nav-right');
    const navLinks = document.querySelectorAll('.nav-links a');

    menuToggle?.addEventListener('click', () => {
        menuToggle.classList.toggle('active');
        navRight?.classList.toggle('active');
    });

    navLinks.forEach((link) => {
        link.addEventListener('click', () => {
            menuToggle?.classList.remove('active');
            navRight?.classList.remove('active');
        });
    });

    // When already on biography page, dropdown clicks activate the tab directly
    document.querySelectorAll('.dropdown-menu a').forEach((link) => {
        link.addEventListener('click', (e) => {
            const href = (link as HTMLAnchorElement).getAttribute('href') ?? '';
            const hash = href.split('#')[1];
            const tabPanel = hash && document.getElementById(hash);
            if (tabPanel && document.querySelector('.cv-tabs-section')) {
                e.preventDefault();
                document.querySelectorAll('.tab-btn').forEach((btn) => btn.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('active'));
                document.querySelector(`.tab-btn[data-tab="${hash}"]`)?.classList.add('active');
                tabPanel.classList.add('active');
                menuToggle?.classList.remove('active');
                navRight?.classList.remove('active');
            }
        });
    });
    const dropdownParent = document.querySelector('.has-dropdown');
    const dropdownLink = dropdownParent?.querySelector(':scope > a');
    dropdownLink?.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
            e.preventDefault();
            dropdownParent?.classList.toggle('dropdown-open');
        }
    });
</script>

<style>
    .navbar {
        background-color: var(--header-foot-bg);
        color: var(--header-foot-text);
        padding: 1rem 2rem;
        box-shadow: 0 2px 8px var(--color-shadow-lg);
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(10px);
    }

    .navbar-container {
        max-width: var(--max-width-container);
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .nav-left {
        flex: 1;
    }

    .nav-links {
        list-style: none;
        display: flex;
        gap: 2rem;
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        color: var(--header-foot-text);
        text-decoration: none;
        font-weight: 500;
        font-size: 1rem;
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius);
        position: relative;
        transition: all var(--transition-speed) ease;
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: 0.25rem;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 3px;
        background: var(--nav-active-underline);
        border-radius: 2px;
        transition: width var(--transition-speed) ease;
    }

    .nav-links a:hover {
        color: var(--header-foot-accent);
        background: var(--nav-active-bg);
        text-decoration: none;
    }

    .nav-links a:hover::after {
        width: 70%;
    }

    .nav-links a.active {
        color: var(--header-foot-accent);
        background: var(--nav-active-bg);
        font-weight: 600;
    }

    .nav-links a.active::after {
        width: 70%;
    }

    .nav-right {
        display: flex;
        align-items: center;
    }

    .logo {
        color: var(--header-foot-text);
        text-decoration: none;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: color var(--transition-speed) ease;
    }

    .logo:hover {
        color: var(--header-foot-accent);
        text-decoration: none;
    }

    .menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 1001;
    }

    .hamburger,
    .hamburger::before,
    .hamburger::after {
        width: 25px;
        height: 3px;
        background: var(--header-foot-text);
        border-radius: 2px;
        transition: all 0.3s ease;
    }

    .hamburger {
        position: relative;
    }

    .hamburger::before,
    .hamburger::after {
        content: '';
        position: absolute;
        left: 0;
    }

    .hamburger::before {
        top: -8px;
    }

    .hamburger::after {
        top: 8px;
    }

    .menu-toggle.active .hamburger {
        background: transparent;
    }

    .menu-toggle.active .hamburger::before {
        top: 0;
        transform: rotate(45deg);
    }

    .menu-toggle.active .hamburger::after {
        top: 0;
        transform: rotate(-45deg);
    }

    @media (max-width: 768px) {
        .navbar {
            padding: 0.75rem 1rem;
        }

        .navbar-container {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            flex-wrap: nowrap;
        }

        .menu-toggle {
            display: flex;
        }

        .logo {
            font-size: 1.1rem;
            white-space: nowrap;
        }

        .nav-left {
            flex: 0 1 auto;
        }

        .nav-right {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: var(--header-foot-bg);
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            box-shadow: 0 4px 8px var(--color-shadow-lg);
            border-top: 1px solid var(--color-border);
        }

        .nav-right.active {
            max-height: 600px;
        }

        .nav-links {
            flex-direction: column;
            gap: 0;
            padding: 0;
            width: 100%;
        }

        .nav-links li {
            width: 100%;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .nav-links a {
            display: block;
            width: 100%;
            font-size: 1rem;
            padding: 1rem 1.5rem;
            text-align: left;
            border-radius: 0;
            background: transparent;
            border-bottom: 1px solid var(--color-border);
            box-sizing: border-box;
        }

        .nav-links li:last-child a {
            border-bottom: none;
        }

        .nav-links a::after {
            display: none;
        }

        .nav-links a:hover {
            background: var(--nav-active-bg);
            color: var(--header-foot-accent);
        }

        .nav-links a.active {
            background: var(--nav-active-bg);
            color: var(--header-foot-accent);
            border-left: 4px solid var(--nav-active-underline);
            padding-left: calc(1.5rem - 4px);
        }

        .has-dropdown .dropdown-menu {
            position: static;
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: none;
            box-shadow: none;
            border: none;
            border-radius: 0;
            padding: 0;
            background: transparent;
            min-width: auto;
            display: block;
        }

        .has-dropdown.dropdown-open .dropdown-menu {
            display: block;
        }

        .dropdown-menu li a {
            padding-left: 2.5rem;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--color-border);
            color: var(--header-foot-text);
        }

        .dropdown-menu li:last-child a {
            border-bottom: none;
        }
    }

    /* Desktop dropdown */
    .has-dropdown {
        position: relative;
    }

    .dropdown-arrow {
        font-size: 0.75rem;
        margin-left: 0.25rem;
        transition: transform var(--transition-speed) ease;
        display: inline-block;
    }

    .has-dropdown:hover .dropdown-arrow {
        transform: rotate(180deg);
    }

    .dropdown-menu {
        display: block;
        list-style: none;
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        background: var(--header-foot-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
        box-shadow: 0 8px 24px var(--color-shadow-lg);
        min-width: 220px;
        padding: 0.4rem 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity var(--transition-speed) ease, transform var(--transition-speed) ease, visibility var(--transition-speed) ease;
        z-index: 999;
    }

    .has-dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .dropdown-menu li a {
        display: block;
        padding: 0.6rem 1.2rem;
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 400;
        transition: background var(--transition-speed) ease, color var(--transition-speed) ease;
        white-space: nowrap;
    }

    .dropdown-menu li a::after {
        display: none;
    }

    .dropdown-menu li a:hover {
        background: var(--nav-active-bg);
        color: var(--header-foot-accent);
    }
</style>
